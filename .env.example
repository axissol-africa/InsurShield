# Settings for docker-compose.yml. Copy to .env at the repository root: cp .env.example .env
# Then replace every CHANGE_ME. Compose refuses to start while a variable is missing.
# Never commit .env — it holds credentials.

# ── PostgreSQL ────────────────────────────────────────────────────────
# apps/api/.env must use the same user, password and port in DATABASE_URL and TEST_DATABASE_URL.
POSTGRES_USER=insurshield
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=insurshield
# Created on a fresh volume beside POSTGRES_DB. The e2e tests drop and recreate it: it must end in _test.
POSTGRES_TEST_DB=insurshield_test
# Keycloak's own database, created on a fresh volume beside POSTGRES_DB.
KEYCLOAK_DB=keycloak
# Host port, bound to 127.0.0.1 only.
POSTGRES_PORT=5432

# ── MinIO (S3 API) ────────────────────────────────────────────────────
# apps/api/.env uses these as S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY. The password needs 8 characters or more.
MINIO_ROOT_USER=insurshield
MINIO_ROOT_PASSWORD=CHANGE_ME
# The private bucket created on first boot; the same value as S3_BUCKET in apps/api/.env.
S3_BUCKET=insurshield-documents
# Host ports, bound to 127.0.0.1 only: the S3 API (S3_ENDPOINT) and the web console.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Keycloak ──────────────────────────────────────────────────────────
# The administrator created on first boot, for the console at http://localhost:<KEYCLOAK_PORT>.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# The insurshield-api client's secret, put into the realm when it is first imported.
# apps/api/.env must hold the same value as KEYCLOAK_CLIENT_SECRET.
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
# Host port, bound to 127.0.0.1 only; KEYCLOAK_ISSUER in apps/api/.env and VITE_KEYCLOAK_URL use it.
KEYCLOAK_PORT=8080
