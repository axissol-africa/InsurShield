// InsurShield data model.
//
// Mirrors the API contract in `frontend/src/api/contracts.js` and the safeguards
// required by `docs/INSURER_API_INTEGRATION.md`. Two rules run through it:
//
//  1. Files are never stored in the database. `Document` holds metadata and an
//     object-storage key; bytes live in S3 (MinIO locally) behind signed URLs.
//  2. Money is `Decimal`, never `Float`. Premiums are ZMW and must reconcile
//     exactly with the insurer's own quotation document.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Enums ───────────────────────────

enum QuoteRequestStatus {
  SUBMITTED
  QUOTED
  EXPIRED
}

enum InsuranceType {
  COMPREHENSIVE
  THIRD_PARTY
}

/// '1q'..'4q' in the contract.
enum CoverageDuration {
  Q1
  Q2
  Q3
  Q4
}

enum InsurerStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum PolicyStatus {
  AWAITING_INSURER_CERTIFICATE
  ACTIVE
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
}

enum ClaimStatus {
  NOTIFIED
  RECEIVED_BY_INSURER
}

enum NcdStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFICATION_REQUIRED
  APPROVED
  REJECTED
}

enum InspectionStatus {
  REQUESTED
  SCHEDULED
  INSPECTOR_ASSIGNED
  IN_PROGRESS
  COMPLETED
  REPORT_READY
  APPROVED
  FAILED
}

enum InspectionRule {
  NOT_REQUIRED
  OPTIONAL
  REQUIRED
}

enum InspectionTiming {
  BEFORE_QUOTATION
  BEFORE_PAYMENT
  AFTER_PAYMENT
}

enum InspectionMethod {
  SELF_CAPTURE
  PHYSICAL
}

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  INSURER_USER
}

enum DocumentKind {
  QUOTATION
  CERTIFICATE
  INSPECTION_PHOTO
  CLAIM_ATTACHMENT
  INSURER_LOGO
  NCD_EVIDENCE
}

// PARKED — SMS phone verification. Keycloak provides TOTP but not SMS, so this
// would live here rather than in the realm. Uncomment this enum together with
// the OtpChallenge model and Customer.phoneVerifiedAt below, then migrate.
// enum OtpPurpose {
//   REGISTRATION
//   PASSWORD_RESET
// }

enum DeliveryStatus {
  PENDING
  DELIVERED
  ACKNOWLEDGED
  FAILED
}

enum DeliveryKind {
  QUOTE_REQUEST
  PAID_POLICY
  CLAIM_NOTIFICATION
}

enum ActorType {
  CUSTOMER
  STAFF
  INSURER
  SYSTEM
}

// ─────────────────────── Identity & consent ───────────────────────

model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  /// The `sub` claim from Keycloak. Credentials live there, never here.
  keycloakId   String    @unique
  fullName     String
  email        String    @unique
  phone        String    @unique
  // PARKED with the OTP flow above — set once SMS verification completes.
  // phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  consents        ConsentRecord[]
  quoteRequests   QuoteRequest[]
  payments        Payment[]
  policies        Policy[]
  claims          ClaimNotification[]
  ncdApplications NcdApplication[]
  inspections     Inspection[]
  documents       Document[]

  @@index([deletedAt])
  @@map("customers")
}

/// Append-only. A customer who re-accepts new terms gets a new row; rows are
/// never updated, so the consent trail stays auditable.
model ConsentRecord {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @db.Uuid
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  privacyVersion String
  termsVersion   String
  acceptedAt     DateTime @default(now())
  ipAddress      String?
  userAgent      String?

  @@index([customerId, acceptedAt])
  @@map("consent_records")
}

