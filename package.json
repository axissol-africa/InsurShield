{
  "name": "insurshield",
  "private": true,
  "version": "0.0.0",
  "description": "InsurShield monorepo \u2014 Zambian motor-insurance marketplace.",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.13.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@insurshield/web",
    "dev:api": "turbo run dev --filter=@insurshield/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:migrate": "npm run db:migrate -w @insurshield/api",
    "db:seed": "npm run db:seed -w @insurshield/api",
    "db:studio": "npm run db:studio -w @insurshield/api",
    "setup": "npm install && npm run infra:up && npm run db:migrate && npm run db:seed",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:release": "node --test scripts/release-gate.test.mjs",
    "release:check": "node scripts/release-gate.mjs",
    "format": "turbo run format",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "test:cov": "turbo run test:cov"
  },
  "devDependencies": {
    "turbo": "^2.11.3"
  },
  "overrides": {
    "@nestjs/platform-express@12.2.0": {
      "multer": "2.5.0"
    },
    "body-parser@>=2.0.0 <2.4.0": "2.4.0",
    "follow-redirects@>=1.16.0 <1.16.2": "1.16.2",
    "qs@>=6.7.0 <6.16.1": "6.16.1",
    "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
    "jsdom@30.1.1": {
      "undici": "8.12.2"
    }
  }
}
