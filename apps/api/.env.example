# Copy to .env for local development: cp apps/api/.env.example apps/api/.env
# Then replace every CHANGE_ME: the API refuses to start while one is left.
# Never commit .env — it holds credentials.

NODE_ENV=development
PORT=4000
# Mounted under this prefix so routes match `apps/web/src/api/contracts.js`.
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────
# Local: the docker-compose postgres service, with the password from the root .env.
# AWS:   swap in the RDS endpoint and add ?sslmode=require
#        postgresql://USER:PASSWORD@my-db.abc123.af-south-1.rds.amazonaws.com:5432/insurshield?sslmode=require
# Either URL may set only the query parameters URL_PARAMETERS in src/config/env.ts lists.
DATABASE_URL=postgresql://insurshield:CHANGE_ME@localhost:5432/insurshield
# Connections in the API's pool, from 2 to 100.
DATABASE_POOL_SIZE=10
# The e2e and migration tests drop and recreate this database and the scratch
# databases named after it. It must end in _test and differ from DATABASE_URL's.
TEST_DATABASE_URL=postgresql://insurshield:CHANGE_ME@localhost:5432/insurshield_test

# ── API docs ──────────────────────────────────────────────────────────
# Swagger UI at /docs. Unset or false in production.
SWAGGER_ENABLED=true

# ── Object storage (S3 API) ───────────────────────────────────────────
# Local: MinIO. Production: real S3 — delete S3_ENDPOINT and S3_FORCE_PATH_STYLE,
# set the region, and prefer an IAM role over static keys.
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_BUCKET=insurshield-documents
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# How long a generated download link stays valid, in seconds.
S3_SIGNED_URL_TTL_SECONDS=300

# ── Uploads ───────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=3145728

# Server-side encryption on upload. Leave unset locally: MinIO rejects the
# header with 501 NotImplemented. On S3 set S3_SSE=AES256, or aws:kms plus
# S3_SSE_KMS_KEY_ID if you manage your own key.
# S3_SSE=AES256
# S3_SSE_KMS_KEY_ID=

# ── Identity (Better Auth) ────────────────────────────────────────────
# Signs the session cookies: at least 32 random characters, for example from
# `openssl rand -hex 32`. Keep it in Secrets Manager in production.
BETTER_AUTH_SECRET=CHANGE_ME_to_at_least_32_random_characters
# The API's public origin. Sign-in, sign-out and registration are served under
# <BETTER_AUTH_URL>/<API_PREFIX>/identity. On https the session cookie is Secure.
BETTER_AUTH_URL=http://localhost:4000
# How many proxies stand in front of the API: 0 when clients connect directly
# (local development, where the Vite proxy runs on the same machine), 1 behind a
# single load balancer. The client address used for rate limits and consent
# records is read past exactly this many proxies.
TRUST_PROXY_HOPS=CHANGE_ME
# Rate limits on the identity routes. Only the e2e tests may set off (NODE_ENV=test).
AUTH_RATE_LIMIT=on

# ── Seed (npm run db:seed) ────────────────────────────────────────────
# Password given to the seeded staff and insurer portal accounts.
SEED_STAFF_PASSWORD=CHANGE_ME
# SEED_DEMO_DATA=false
# SEED_RESET_DEMO=true
# SEED_RESET_PASSWORDS=true
