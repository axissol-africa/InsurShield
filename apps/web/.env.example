# Copy to .env.local and adjust. All variables must be prefixed VITE_ to reach the browser.

# mock = records live in browser storage (default, no backend needed)
# http = call the backend REST API
VITE_API_MODE=mock

# Backend base URL when VITE_API_MODE=http (absolute, or a path proxied by the host)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Simulated latency for mock calls, in milliseconds
VITE_MOCK_LATENCY_MS=600
